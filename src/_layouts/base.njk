<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "Photo Blog" }}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="container">
            <h1><a href="/">📸 Photo Blog</a></h1>
            <nav>
                <a href="/">Home</a>
                {% if eleventy.edge.cookies.authenticated %}
                <a href="/logout">Logout</a>
                {% else %}
                <a href="/login">Login</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="container">
        {{ content | safe }}
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 Photo Blog. Built with <a href="https://www.11ty.dev/" target="_blank">Eleventy</a></p>
        </div>
    </footer>
</body>
</html>
