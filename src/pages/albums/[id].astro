---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';
import { getAlbumBySlug } from '../../lib/directus';

const { user, membership } = await getSession(Astro.cookies);
const isApproved = membership?.status === 'approved';

if (!isApproved) {
  return Astro.redirect('/');
}

const { id } = Astro.params;

// Fetch album from Directus CMS
const album = await getAlbumBySlug(id!);

if (!album) {
  return Astro.redirect('/');
}

const albumDate = album.date_published || album.date_created;
const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL;
---

<Layout title={album.title} user={user} membership={membership}>
  <div class="album-header">
    <h2>{album.title}</h2>
    <p class="album-date">
      {new Date(albumDate).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      })}
    </p>
    {album.description && (
      <p class="album-description">{album.description}</p>
    )}
  </div>

  {album.photos && album.photos.length > 0 ? (
    <div class="photo-grid">
      {album.photos
        .sort((a, b) => (a.sort || 0) - (b.sort || 0))
        .map((photo) => (
          <div class="photo-item">
            <img
              src={`${directusUrl}/assets/${photo.url}`}
              alt={photo.caption || album.title}
            />
            {photo.caption && (
              <p class="photo-caption">{photo.caption}</p>
            )}
          </div>
        ))}
    </div>
  ) : (
    <div class="message info">
      <p>No photos in this album yet.</p>
    </div>
  )}

  <div style="margin-top: 2rem;">
    <a href="/" style="color: #666; text-decoration: none;">← Back to albums</a>
  </div>
</Layout>
