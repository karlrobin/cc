---
import Layout from '../layouts/Layout.astro';

const { url } = Astro;
const success = url.searchParams.get('success') === 'true';
const already = url.searchParams.get('already') === 'true';
const error = url.searchParams.get('error') === 'true';
---

<Layout title="Unsubscribe">
  <div class="container">
    <div class="message-box">
      {success && (
        <>
          <h1>✅ Unsubscribed Successfully</h1>
          <p>You've been unsubscribed from our newsletter.</p>
          <p>You won't receive any more newsletter emails from us.</p>
        </>
      )}

      {already && (
        <>
          <h1>ℹ️ Already Unsubscribed</h1>
          <p>You're already unsubscribed from our newsletter.</p>
          <p>You won't receive any newsletter emails.</p>
        </>
      )}

      {error && (
        <>
          <h1>❌ Error</h1>
          <p>Sorry, there was an error processing your unsubscribe request.</p>
          <p>Please try again or contact us for help.</p>
        </>
      )}

      {!success && !already && !error && (
        <>
          <h1>Newsletter</h1>
          <p>Manage your newsletter subscription.</p>
        </>
      )}

      <div class="actions">
        <a href="/" class="btn">Return to Homepage</a>
        <a href="/signin" class="btn-secondary">Sign In</a>
      </div>

      <p class="note">
        If you want to resubscribe later, you can do so from your account settings
        after signing in.
      </p>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem;
  }

  .message-box {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 3rem 2rem;
    text-align: center;
  }

  h1 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  p {
    margin: 1rem 0;
    color: #666;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin: 2rem 0;
  }

  .btn,
  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
  }

  .btn {
    background: #0066cc;
    color: white;
  }

  .btn:hover {
    background: #0052a3;
  }

  .btn-secondary {
    background: white;
    color: #0066cc;
    border: 1px solid #0066cc;
  }

  .btn-secondary:hover {
    background: #f0f7ff;
  }

  .note {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: #999;
  }
</style>
