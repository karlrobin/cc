---
import Layout from '../layouts/Layout.astro';
import { getSession } from '../lib/auth';
import { getPublishedAlbums } from '../lib/directus';

const { user, membership } = await getSession(Astro.cookies);
const isApproved = membership?.status === 'approved';

// Fetch albums from Directus CMS
const albums = await getPublishedAlbums();
---

<Layout title="Photo Albums" user={user} membership={membership}>
  {!isApproved ? (
    <div class="message info" style="max-width: 600px; margin: 2rem auto;">
      {!user ? (
        <div>
          <h3 style="margin-bottom: 0.5rem;">Welcome!</h3>
          <p>This is a private photo blog. Please <a href="/signin">sign in</a> or <a href="/request-access">request access</a> to view our albums.</p>
        </div>
      ) : membership?.status === 'pending' ? (
        <div>
          <h3 style="margin-bottom: 0.5rem;">Membership Pending</h3>
          <p>Thanks for requesting access! Your membership request is being reviewed. We'll email you once it's approved.</p>
        </div>
      ) : (
        <div>
          <h3 style="margin-bottom: 0.5rem;">Request Membership</h3>
          <p>You need to <a href="/request-access">request membership</a> to view our private photo albums.</p>
        </div>
      )}
    </div>
  ) : (
    <>
      <h2 style="margin: 2rem 0 1rem 0;">Photo Albums</h2>
      {albums.length === 0 ? (
        <div class="message info">
          <p>No albums available yet. Check back soon!</p>
        </div>
      ) : (
        <div class="albums-grid">
          {albums.map(album => {
            const coverImage = album.cover_image
              ? `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${album.cover_image}`
              : (album.photos && album.photos.length > 0
                  ? `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${album.photos[0].url}`
                  : 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&h=600&fit=crop');

            const albumDate = album.date_published || album.date_created;
            const photoCount = album.photos?.length || 0;

            return (
              <a href={`/albums/${album.slug}`} class="album-card">
                <img src={coverImage} alt={album.title} class="album-card-image" />
                <div class="album-card-content">
                  <h3>{album.title}</h3>
                  <p class="album-card-date">
                    {new Date(albumDate).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </p>
                  {album.description && (
                    <p class="album-card-description">{album.description}</p>
                  )}
                  <p style="color: #999; font-size: 0.875rem; margin-top: 0.5rem;">
                    {photoCount} {photoCount === 1 ? 'photo' : 'photos'}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </>
  )}
</Layout>
