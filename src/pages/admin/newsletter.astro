---
import Layout from '../../layouts/Layout.astro';
import { getSession } from '../../lib/auth';
import { getSettings, getAlbumsSince, getSubscribedMembers } from '../../lib/directus';

const { user, membership } = await getSession(Astro.cookies);

// Redirect if not authenticated
if (!user) {
  return Astro.redirect('/signin');
}

// Redirect if not admin
if (!membership || membership.status !== 'approved' || membership.role !== 'admin') {
  return Astro.redirect('/');
}

// Get last newsletter sent date
const settings = await getSettings();
const lastSent = settings?.last_newsletter_sent;

// Calculate date for "since last newsletter" or default to 30 days ago
const sinceDate = lastSent
  ? new Date(lastSent)
  : new Date(Date.now() - 30 * 24 * 60 * 60 * 1000); // 30 days ago

// Get new albums since last newsletter
const newAlbums = await getAlbumsSince(sinceDate.toISOString());

// Get subscribed members count
const subscribers = await getSubscribedMembers();

const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL;
---

<Layout title="Newsletter Admin" user={user} membership={membership}>
  <div class="admin-container">
    <h1>Newsletter Administration</h1>

    <div class="stats">
      <div class="stat-card">
        <div class="stat-label">Subscribers</div>
        <div class="stat-value">{subscribers.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">New Albums</div>
        <div class="stat-value">{newAlbums.length}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Last Sent</div>
        <div class="stat-value">
          {lastSent
            ? new Date(lastSent).toLocaleDateString()
            : 'Never'}
        </div>
      </div>
    </div>

    {newAlbums.length > 0 ? (
      <>
        <div class="section">
          <h2>New Albums Since Last Newsletter</h2>
          <p class="note">
            Showing albums published since {sinceDate.toLocaleDateString()}
          </p>

          <div class="albums-preview">
            {newAlbums.map(album => {
              const coverPhoto = album.photos?.[0];
              const coverUrl = coverPhoto
                ? `${directusUrl}/assets/${coverPhoto.url}?width=400&quality=80`
                : '';
              const photoCount = album.photos?.length || 0;

              return (
                <div class="album-card">
                  {coverUrl && (
                    <img src={coverUrl} alt={album.title} />
                  )}
                  <div class="album-info">
                    <h3>{album.title}</h3>
                    <p>{album.description || 'No description'}</p>
                    <p class="meta">
                      {photoCount} photo{photoCount !== 1 ? 's' : ''} •
                      Published {new Date(album.date_published || album.date_created).toLocaleDateString()}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <div class="section">
          <h2>Send Newsletter</h2>
          <p>
            This will send an email to all {subscribers.length} subscribed member{subscribers.length !== 1 ? 's' : ''}
            with the {newAlbums.length} new album{newAlbums.length !== 1 ? 's' : ''} shown above.
          </p>

          <form method="POST" action="/api/admin/newsletter/send" onsubmit="return confirm('Send newsletter to all subscribers?')">
            <div class="form-group">
              <label for="subject">Email Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                value={`New Albums: ${newAlbums.map(a => a.title).join(', ')}`}
                required
              />
            </div>

            <div class="form-group">
              <label for="preview_text">Preview Text (appears in email clients)</label>
              <input
                type="text"
                id="preview_text"
                name="preview_text"
                value={`${newAlbums.length} new photo album${newAlbums.length !== 1 ? 's' : ''} have been added`}
                maxlength="100"
              />
            </div>

            <button type="submit" class="btn-primary">
              Send Newsletter to {subscribers.length} Subscriber{subscribers.length !== 1 ? 's' : ''}
            </button>
          </form>
        </div>
      </>
    ) : (
      <div class="section no-content">
        <h2>No New Albums</h2>
        <p>
          There are no new albums since the last newsletter{lastSent ? ` (${new Date(lastSent).toLocaleDateString()})` : ''}.
        </p>
        <p>Publish some albums first, then return here to send a newsletter.</p>
      </div>
    )}

    <div class="section">
      <h2>Subscriber List</h2>
      <div class="subscribers-list">
        {subscribers.length > 0 ? (
          <ul>
            {subscribers.map(sub => (
              <li>
                {sub.email}
                {sub.role === 'admin' && <span class="badge">Admin</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p>No subscribers yet.</p>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .admin-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    margin-bottom: 2rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #666;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: bold;
    color: #0066cc;
  }

  .section {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .section h2 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .note {
    color: #666;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .albums-preview {
    display: grid;
    gap: 1rem;
  }

  .album-card {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid #eee;
    border-radius: 4px;
    background: #fafafa;
  }

  .album-card img {
    width: 150px;
    height: 100px;
    object-fit: cover;
    border-radius: 4px;
  }

  .album-info {
    flex: 1;
  }

  .album-info h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.125rem;
  }

  .album-info p {
    margin: 0.5rem 0;
    color: #666;
  }

  .meta {
    font-size: 0.875rem;
    color: #999 !important;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .form-group input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
  }

  .btn-primary {
    padding: 1rem 2rem;
    background: #0066cc;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: #0052a3;
  }

  .no-content {
    text-align: center;
    padding: 3rem 2rem;
  }

  .subscribers-list ul {
    list-style: none;
    padding: 0;
  }

  .subscribers-list li {
    padding: 0.75rem;
    border-bottom: 1px solid #eee;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .subscribers-list li:last-child {
    border-bottom: none;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: #0066cc;
    color: white;
    font-size: 0.75rem;
    border-radius: 4px;
  }
</style>
