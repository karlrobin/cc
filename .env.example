# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Directus CMS Configuration
# Your Directus instance URL
# Can be self-hosted or Directus Cloud: https://directus.cloud
PUBLIC_DIRECTUS_URL=http://localhost:8055

# Directus Admin Token (for server-side operations like sending newsletters)
# Generate in Directus: Settings → Access Tokens → Create Token
# Needs permissions to update settings and newsletters
DIRECTUS_ADMIN_TOKEN=your-admin-token-here

# Application URL (for magic link redirects)
# In development: http://localhost:4321
# In production: https://yourdomain.com
PUBLIC_APP_URL=http://localhost:4321

# Mailgun Configuration (for newsletter emails, optional)
# Sign up at https://www.mailgun.com
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@mg.yourdomain.com
